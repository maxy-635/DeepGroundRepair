  "origin_code": "import paddle\nimport paddle.nn as nn\nimport paddle.nn.functional as F\n\nclass DL_Model(nn.Layer):\n    def __init__(self):\n        super(DL_Model, self).__init__()\n\n        # Initial convolutional layer\n        self.conv1 = nn.Conv2D(\n            in_channels=3,\n            out_channels=64,\n            kernel_size=3,\n            stride=1,\n            padding=1\n        )\n\n        # Channel attention mechanism\n        self.avg_pool = nn.AdaptiveAvgPool2D(output_size=1)\n        self.max_pool = nn.AdaptiveMaxPool2D(output_size=1)\n\n        self.fc1_avg = nn.Linear(in_features=64, out_features=32)\n        self.fc2_avg = nn.Linear(in_features=32, out_features=64)\n\n        self.fc1_max = nn.Linear(in_features=64, out_features=32)\n        self.fc2_max = nn.Linear(in_features=32, out_features=64)\n\n        # Spatial attention mechanism\n        self.avg_pool_spatial = nn.AdaptiveAvgPool2D(output_size=1)\n        self.max_pool_spatial = nn.AdaptiveMaxPool2D(output_size=1)\n\n        # Final fully connected layer\n        self.fc_final = nn.Linear(in_features=128, out_features=10)\n\n    def forward(self, x):\n        # Initial convolution\n        x = self.conv1(x)\n\n        # Channel attention\n        avg_out = self.avg_pool(x)\n        avg_out = avg_out.flatten(1)\n        avg_out = self.fc1_avg(avg_out)\n        avg_out = F.relu(avg_out)\n        avg_out = self.fc2_avg(avg_out)\n        avg_out = avg_out.unsqueeze(-1).unsqueeze(-1)\n\n        max_out = self.max_pool(x)\n        max_out = max_out.flatten(1)\n        max_out = self.fc1_max(max_out)\n        max_out = F.relu(max_out)\n        max_out = self.fc2_max(max_out)\n        max_out = max_out.unsqueeze(-1).unsqueeze(-1)\n\n        channel_attention = paddle.add(avg_out, max_out)\n        channel_attention = F.relu(channel_attention)\n        x = paddle.multiply(x, channel_attention)\n\n        # Spatial attention\n        avg_spatial = self.avg_pool_spatial(x)\n        max_spatial = self.max_pool_spatial(x)\n        spatial_attention = paddle.concat([avg_spatial, max_spatial], axis=1)\n\n        # Combine channel and spatial attention\n        x = paddle.multiply(x, spatial_attention)\n\n        # Final classification\n        x = x.flatten(1)\n        x = self.fc_final(x)\n        x = F.softmax(x, axis=1)\n\n        return x\n\nif __name__ == \"__main__\":\n    model = DL_Model()\n    input_tensor = paddle.randn((32, 3, 32, 32))  # batch_size=32, channels=3, height=32, width=32\n    output_tensor = model(input_tensor)\n    print(output_tensor.shape)  # Expected output shape: [32, 10]",
  "final_code": "import paddle\nimport paddle.nn as nn\nimport paddle.nn.functional as F\n\nclass DL_Model(nn.Layer):\n    def __init__(self):\n        super(DL_Model, self).__init__()\n\n        # Initial convolutional layer\n        self.conv1 = nn.Conv2D(\n            in_channels=3,\n            out_channels=64,\n            kernel_size=3,\n            stride=1,\n            padding=1\n        )\n\n        # Channel attention mechanism\n        self.avg_pool = nn.AdaptiveAvgPool2D(output_size=1)\n        self.max_pool = nn.AdaptiveMaxPool2D(output_size=1)\n\n        self.fc1_avg = nn.Linear(in_features=64, out_features=32)\n        self.fc2_avg = nn.Linear(in_features=32, out_features=64)\n\n        self.fc1_max = nn.Linear(in_features=64, out_features=32)\n        self.fc2_max = nn.Linear(in_features=32, out_features='mask')\n\n        # Spatial attention mechanism\n        self.avg_pool_spatial = nn.AdaptiveAvgPool2D(output_size=1)\n        self.max_pool_spatial = nn.AdaptiveMaxPool2D(output_size='mask')\n\n        # Final fully connected layer\n        self.fc_final = nn.Linear(in_features=128, out_features=10)\n\n    def forward(self, x):\n        # the initial shape of x is: (32, 3, 32, 32)\n        # Initial convolution\n        x = self.conv1(x)  # output tensor shape: (32, 64, 32, 32)\n\n        # Channel attention\n        avg_out = self.avg_pool(x)  # output tensor shape: (32, 64, 1, 1)\n        avg_out = avg_out.flatten(1)  # output tensor shape: (32, 64)\n        avg_out = self.fc1_avg(avg_out)  # output tensor shape: (32, 32)\n        avg_out = F.relu(avg_out)  # output tensor shape: (32, 32)\n        avg_out = self.fc2_avg(avg_out)  # output tensor shape: (32, 64)\n        avg_out = avg_out.unsqueeze(-1).unsqueeze(-1)  # output tensor shape: (32, 64, 1, 1)\n\n        max_out = self.max_pool(x)  # output tensor shape: (32, 64, 1, 1)\n        max_out = max_out.flatten(1)  # output tensor shape: (32, 64)\n        max_out = self.fc1_max(max_out)  # output tensor shape: (32, 32)\n        max_out = F.relu(max_out)  # output tensor shape: (32, 32)\n        max_out = self.fc2_max(max_out)  # output tensor shape of this layer should be (32, 64)\n        max_out = max_out.unsqueeze(-1).unsqueeze(-1)\n\n        channel_attention = paddle.add(avg_out, max_out)\n        channel_attention = F.relu(channel_attention)\n        x = paddle.multiply(x, channel_attention)\n\n        # Spatial attention\n        avg_spatial = self.avg_pool_spatial(x)\n        max_spatial = self.max_pool_spatial(x)  # output tensor shape of this layer should be (32, 64, 1, 1)\n        spatial_attention = paddle.concat([avg_spatial, max_spatial], axis=1)\n\n        # Combine channel and spatial attention\n        x = paddle.multiply(x, spatial_attention)\n\n        # Final classification\n        x = x.flatten(1)\n        x = self.fc_final(x)\n        x = F.softmax(x, axis=1)\n\n        return x\n\nif __name__ == \"__main__\":\n    model = DL_Model()\n    input_tensor = paddle.randn((32, 3, 32, 32))  # batch_size=32, channels=3, height=32, width=32\n    output_tensor = model(input_tensor)\n    print(output_tensor.shape)  # Expected output shape: [32, 10]"
