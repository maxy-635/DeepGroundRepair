  "origin_code": "import paddle\nimport paddle.nn as nn\nimport paddle.distribution as dist\n\nclass DL_Model(nn.Layer):\n    def __init__(self):\n        super(DL_Model, self).__init__()\n\n        # First block: Feature extraction\n        self.block1 = nn.Sequential(\n            nn.Conv2D(in_channels=3, out_channels=16, kernel_size=3, stride=1, padding=1),\n            nn.ReLU(),\n            nn.Conv2D(in_channels=16, out_channels=32, kernel_size=3, stride=1, padding=1),\n            nn.ReLU(),\n            nn.AvgPool2D(kernel_size=2, stride=2, padding=0)\n        )\n\n        # Second block: Channel weight generation and application\n        self.global_pool = nn.AdaptiveAvgPool2D((1, 1))\n        self.fc1 = nn.Linear(in_features=32, out_features=32)\n        self.fc2 = nn.Linear(in_features=32, out_features=32)\n        self.reshape = dist.ReshapeTransform(in_event_shape=[32], out_event_shape=[32, 1, 1])\n        \n        # Classification layer\n        self.flatten = nn.Flatten()\n        self.fc_classifier = nn.Linear(in_features=32 * 32 * 32, out_features=10)\n        \n\n    def forward(self, x):\n        # First block\n        x1 = self.block1(x)\n\n        # Second block\n        x_gap = self.global_pool(x1)\n        x_gap = self.flatten(x_gap)\n        x_gap = self.fc1(x_gap)\n        x_gap = self.fc2(x_gap)\n        x_gap = self.reshape(x_gap)\n\n        # Apply channel weights\n        x = x * x_gap\n\n        # Classification\n        x = self.flatten(x)\n        x = self.fc_classifier(x)\n        return x\n\n\nif __name__ == \"__main__\":\n    model = DL_Model()\n    input_tensor = paddle.randn([1, 3, 32, 32])  # Example input tensor\n    output_tensor = model(input_tensor)\n    print(output_tensor.shape)",
  "final_code": "import paddle\nimport paddle.nn as nn\nimport paddle.distribution as dist\n\nclass DL_Model(nn.Layer):\n    def __init__(self):\n        super(DL_Model, self).__init__()\n\n        # First block: Feature extraction\n        self.block1 = nn.Sequential(\n            nn.Conv2D(in_channels=3, out_channels=16, kernel_size=3, stride=1, padding=1),\n            nn.ReLU(),\n            nn.Conv2D(in_channels=16, out_channels=32, kernel_size=3, stride=1, padding=1),\n            nn.ReLU(),\n            nn.AvgPool2D(kernel_size=2, stride=2, padding=0)\n        )\n\n        # Second block: Channel weight generation and application\n        self.global_pool = nn.AdaptiveAvgPool2D(output_size='mask')\n        self.fc1 = nn.Linear(in_features=32, out_features=32)\n        self.fc2 = nn.Linear(in_features=32, out_features='mask')\n        self.reshape = dist.ReshapeTransform(in_event_shape=[32], out_event_shape=[32, 1, 1])\n        \n        # Classification layer\n        self.flatten = nn.Flatten()\n        self.fc_classifier = nn.Linear(in_features=32 * 32 * 32, out_features=10)\n        \n\n    def forward(self, x):\n        # the initial shape of x is: (1, 3, 32, 32)\n        # First block\n        x1 = self.block1(x)  # output tensor shape: (1, 32, 16, 16)\n\n        # Second block\n        x_gap = self.global_pool(x1)  # output tensor shape of this layer should be (1, 32, 32, 32)\n        x_gap = self.flatten(x_gap)\n        x_gap = self.fc1(x_gap)\n        x_gap = self.fc2(x_gap)  # output tensor shape of this layer should be (1, 32)\n        x_gap = self.reshape(x_gap)\n\n        # Apply channel weights\n        x = x * x_gap\n\n        # Classification\n        x = self.flatten(x)\n        x = self.fc_classifier(x)\n        return x\n\n\nif __name__ == \"__main__\":\n    model = DL_Model()\n    input_tensor = paddle.randn([1, 3, 32, 32])  # Example input tensor\n    output_tensor = model(input_tensor)\n    print(output_tensor.shape)"
}