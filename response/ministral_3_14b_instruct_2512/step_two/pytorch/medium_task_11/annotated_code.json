  "origin_code": "import torch\nimport torch.nn as nn\nimport torch.nn.functional as F\n\nclass DL_Model(nn.Module):\n    def __init__(self):\n        super(DL_Model, self).__init__()\n\n        # Initial convolutional layer\n        self.conv1 = nn.Conv2d(in_channels=3, out_channels=64, kernel_size=3, stride=1, padding=1)\n\n        # Channel attention module\n        self.avg_pool = nn.AdaptiveAvgPool2d(1)\n        self.max_pool = nn.AdaptiveMaxPool2d(1)\n\n        self.fc1_avg = nn.Linear(in_features=64, out_features=32)\n        self.fc2_avg = nn.Linear(in_features=32, out_features=64)\n\n        self.fc1_max = nn.Linear(in_features=64, out_features=32)\n        self.fc2_max = nn.Linear(in_features=32, out_features=64)\n\n        # Spatial attention module\n        self.avg_pool_spatial = nn.Sequential(\n            nn.AvgPool2d(kernel_size=3, stride=1, padding=1),\n            nn.ReLU(inplace=True)\n        )\n\n        self.max_pool_spatial = nn.Sequential(\n            nn.MaxPool2d(kernel_size=3, stride=1, padding=1),\n            nn.ReLU(inplace=True)\n        )\n\n        # Final layers\n        self.fc_final = nn.Linear(in_features=128, out_features=10)  # 10 classes for CIFAR-10\n\n    def forward(self, x):\n        # Initial convolution\n        x = self.conv1(x)\n        x = F.relu(x)\n\n        # Channel attention\n        avg_out = self.avg_pool(x)\n        avg_out = avg_out.view(avg_out.size(0), -1)\n        avg_out = self.fc1_avg(avg_out)\n        avg_out = F.relu(avg_out)\n        avg_out = self.fc2_avg(avg_out)\n        avg_out = torch.sigmoid(avg_out)\n        avg_out = avg_out.view(avg_out.size(0), -1, 1, 1)\n\n        max_out = self.max_pool(x)\n        max_out = max_out.view(max_out.size(0), -1)\n        max_out = self.fc1_max(max_out)\n        max_out = F.relu(max_out)\n        max_out = self.fc2_max(max_out)\n        max_out = torch.sigmoid(max_out)\n        max_out = max_out.view(max_out.size(0), -1, 1, 1)\n\n        channel_attention = avg_out + max_out\n        x = x * channel_attention\n\n        # Spatial attention\n        avg_spatial = self.avg_pool_spatial(x)\n        max_spatial = self.max_pool_spatial(x)\n\n        # Concatenate along channel dimension\n        spatial_attention = torch.cat((avg_spatial, max_spatial), dim=1)\n\n        # Combine with channel features\n        x = x * spatial_attention\n\n        # Flatten and final classification\n        x = x.view(x.size(0), -1)\n        x = self.fc_final(x)\n\n        return x\n\nif __name__ == \"__main__\":\n    model = DL_Model()\n    input_tensor = torch.randn(1, 3, 32, 32)  # Batch size 1, 3 channels, 32x32 image\n    output_tensor = model(input_tensor)\n    print(output_tensor.shape)",
  "final_code": "import torch\nimport torch.nn as nn\nimport torch.nn.functional as F\n\nclass DL_Model(nn.Module):\n    def __init__(self):\n        super(DL_Model, self).__init__()\n\n        # Initial convolutional layer\n        self.conv1 = nn.Conv2d(in_channels=3, out_channels=64, kernel_size=3, stride=1, padding=1)\n\n        # Channel attention module\n        self.avg_pool = nn.AdaptiveAvgPool2d(1)\n        self.max_pool = nn.AdaptiveMaxPool2d(1)\n\n        self.fc1_avg = nn.Linear(in_features=64, out_features=32)\n        self.fc2_avg = nn.Linear(in_features=32, out_features=64)\n\n        self.fc1_max = nn.Linear(in_features=64, out_features=32)\n        self.fc2_max = nn.Linear(in_features=32, out_features='mask')\n\n        # Spatial attention module\n        self.avg_pool_spatial = nn.Sequential(\n            nn.AvgPool2d(kernel_size=3, stride=1, padding=1),\n            nn.ReLU(inplace=True)\n        )\n\n        self.max_pool_spatial = nn.Sequential(\n            nn.MaxPool2d(kernel_size=3, stride=1, padding=1),\n            nn.ReLU(inplace=True)\n        )\n\n        # Final layers\n        self.fc_final = nn.Linear(in_features=128, out_features=10)  # 10 classes for CIFAR-10\n\n    def forward(self, x):\n        # the initial shape of x is: (1, 3, 32, 32)\n        # Initial convolution\n        x = self.conv1(x)  # output tensor shape: (1, 64, 32, 32)\n        x = F.relu(x)  # output tensor shape: (1, 64, 32, 32)\n\n        # Channel attention\n        avg_out = self.avg_pool(x)  # output tensor shape: (1, 64, 1, 1)\n        avg_out = avg_out.view(avg_out.size(0), -1)  # output tensor shape: (1, 64)\n        avg_out = self.fc1_avg(avg_out)  # output tensor shape: (1, 32)\n        avg_out = F.relu(avg_out)  # output tensor shape: (1, 32)\n        avg_out = self.fc2_avg(avg_out)  # output tensor shape: (1, 64)\n        avg_out = torch.sigmoid(avg_out)  # output tensor shape: (1, 64)\n        avg_out = avg_out.view(avg_out.size(0), -1, 1, 1)  # output tensor shape: (1, 64, 1, 1)\n\n        max_out = self.max_pool(x)  # output tensor shape: (1, 64, 1, 1)\n        max_out = max_out.view(max_out.size(0), -1)  # output tensor shape: (1, 64)\n        max_out = self.fc1_max(max_out)  # output tensor shape: (1, 32)\n        max_out = F.relu(max_out)  # output tensor shape: (1, 32)\n        max_out = self.fc2_max(max_out)  # output tensor shape of this layer should be (1, 64)\n        max_out = torch.sigmoid(max_out)\n        max_out = max_out.view(max_out.size(0), -1, 1, 1)\n\n        channel_attention = avg_out + max_out\n        x = x * channel_attention\n\n        # Spatial attention\n        avg_spatial = self.avg_pool_spatial(x)\n        max_spatial = self.max_pool_spatial(x)\n\n        # Concatenate along channel dimension\n        spatial_attention = torch.cat((avg_spatial, max_spatial), dim=1)\n\n        # Combine with channel features\n        x = x * spatial_attention\n\n        # Flatten and final classification\n        x = x.view(x.size(0), -1)\n        x = self.fc_final(x)\n\n        return x\n\nif __name__ == \"__main__\":\n    model = DL_Model()\n    input_tensor = torch.randn(1, 3, 32, 32)  # Batch size 1, 3 channels, 32x32 image\n    output_tensor = model(input_tensor)\n    print(output_tensor.shape)"
